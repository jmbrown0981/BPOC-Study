        <mxCell id="tjCSE-g3T6pwhyQRhLR4-31" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CCE5FF;" value="&lt;b&gt;ADMINISTRATIVE WITH OTHER AGENCIES&lt;/b&gt;" vertex="1">
