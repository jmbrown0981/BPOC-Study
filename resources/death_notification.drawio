        <mxCell id="tjCSE-g3T6pwhyQRhLR4-33" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CCE5FF;" value="Preserve and label package containing deceased&#39;s clothes and personal effects" vertex="1">
