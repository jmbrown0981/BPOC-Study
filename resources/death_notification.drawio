        <mxCell id="tjCSE-g3T6pwhyQRhLR4-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CCCCCC;" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;Death Notification&lt;/font&gt;" vertex="1">
          <mxGeometry height="40" width="840" as="geometry" />
        </mxCell>
        <mxCell id="tjCSE-g3T6pwhyQRhLR4-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CCFF99;" value="Establish identity of deceased" vertex="1">
          <mxGeometry height="60" width="120" y="100" as="geometry" />
        </mxCell>
        <mxCell id="tjCSE-g3T6pwhyQRhLR4-4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CCFF99;" value="Get medical info about person to be informed of death" vertex="1">
          <mxGeometry height="60" width="120" y="160" as="geometry" />
        </mxCell>
        <mxCell id="tjCSE-g3T6pwhyQRhLR4-5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CCFF99;" value="Go.&lt;div&gt;DO NOT CALL.&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="120" y="220" as="geometry" />
        </mxCell>
        <mxCell id="tjCSE-g3T6pwhyQRhLR4-6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CCFF99;" value="At least one person should be in uniform." vertex="1">
          <mxGeometry height="60" width="120" y="280" as="geometry" />
        </mxCell>
        <mxCell id="tjCSE-g3T6pwhyQRhLR4-7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFF99;" value="Talk about feelings with partner." vertex="1">
          <mxGeometry height="60" width="120" x="120" y="100" as="geometry" />
        </mxCell>
        <mxCell id="tjCSE-g3T6pwhyQRhLR4-8" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#99FFFF;" value="If a child answers the door, ask to speak to parents." vertex="1">
          <mxGeometry height="60" width="120" x="240" y="100" as="geometry" />
        </mxCell>
        <mxCell id="tjCSE-g3T6pwhyQRhLR4-9" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#99FFFF;" value="Present credentials and ask to enter" vertex="1">
          <mxGeometry height="60" width="120" x="240" y="160" as="geometry" />
        </mxCell>
        <mxCell id="tjCSE-g3T6pwhyQRhLR4-10" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#99FFFF;" value="Sit Down.&lt;div&gt;DO NOT BE STIFF.&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="120" x="240" y="220" as="geometry" />
        </mxCell>
        <mxCell id="tjCSE-g3T6pwhyQRhLR4-11" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFCCCC;" value="Convey the information simply and directly" vertex="1">
          <mxGeometry height="60" width="120" x="360" y="100" as="geometry" />
        </mxCell>
        <mxCell id="tjCSE-g3T6pwhyQRhLR4-12" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFCCCC;" value="Ask parents if they want to tell children, or if they want you to tell children" vertex="1">
          <mxGeometry height="60" width="120" x="360" y="160" as="geometry" />
        </mxCell>
        <mxCell id="tjCSE-g3T6pwhyQRhLR4-13" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFCCCC;" value="DO NOT discount anyone&#39;s feelings (theirs or yours)" vertex="1">
          <mxGeometry height="60" width="120" x="360" y="220" as="geometry" />
        </mxCell>
        <mxCell id="tjCSE-g3T6pwhyQRhLR4-14" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFCCCC;" value="Be prepared if the bereaved goes into shock" vertex="1">
          <mxGeometry height="60" width="120" x="360" y="280" as="geometry" />
        </mxCell>
        <mxCell id="tjCSE-g3T6pwhyQRhLR4-15" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFCCCC;" value="EMPATHIZE with the survivors" vertex="1">
          <mxGeometry height="60" width="120" x="360" y="340" as="geometry" />
        </mxCell>
        <mxCell id="tjCSE-g3T6pwhyQRhLR4-16" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFCCCC;" value="Answer questions honestly. Provide information that will not jeopardize investigation." vertex="1">
          <mxGeometry height="80" width="120" x="360" y="400" as="geometry" />
        </mxCell>
        <mxCell id="tjCSE-g3T6pwhyQRhLR4-17" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFCCCC;" value="Offer to make calls for them" vertex="1">
          <mxGeometry height="60" width="120" x="360" y="480" as="geometry" />
        </mxCell>
        <mxCell id="tjCSE-g3T6pwhyQRhLR4-18" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#99CCFF;" value="Inform survivors they may need to identify the deceased" vertex="1">
          <mxGeometry height="60" width="120" x="480" y="100" as="geometry" />
        </mxCell>
        <mxCell id="tjCSE-g3T6pwhyQRhLR4-19" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#99CCFF;" value="Explain why an autopsy is necessary and how they can get a copy of the report" vertex="1">
          <mxGeometry height="60" width="120" x="480" y="160" as="geometry" />
        </mxCell>
        <mxCell id="tjCSE-g3T6pwhyQRhLR4-20" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CCE5FF;" value="Tell hospital personnel what info the family has been given" vertex="1">
          <mxGeometry height="60" width="120" x="600" y="100" as="geometry" />
        </mxCell>
        <mxCell id="tjCSE-g3T6pwhyQRhLR4-21" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#99CCFF;" value="Inform survivors that law enforcement may need to contact them later" vertex="1">
          <mxGeometry height="60" width="120" x="480" y="220" as="geometry" />
        </mxCell>
        <mxCell id="tjCSE-g3T6pwhyQRhLR4-22" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#99CCFF;" value="DO NOT leave survivors alone" vertex="1">
          <mxGeometry height="60" width="120" x="480" y="280" as="geometry" />
        </mxCell>
        <mxCell id="tjCSE-g3T6pwhyQRhLR4-23" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#99CCFF;" value="Stay with the survivors and help with decisions" vertex="1">
          <mxGeometry height="60" width="120" x="480" y="340" as="geometry" />
        </mxCell>
        <mxCell id="tjCSE-g3T6pwhyQRhLR4-24" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#99CCFF;" value="Provide survivors with names and phone numbers of officers" vertex="1">
          <mxGeometry height="60" width="120" x="480" y="400" as="geometry" />
        </mxCell>
