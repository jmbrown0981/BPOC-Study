        <mxCell id="tjCSE-g3T6pwhyQRhLR4-34" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CCE5FF;" value="Allow hospitals adequate time to prepare remains for identification" vertex="1">
